[Unit]
Description=linear.co.za GitHub API proxy
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/linear/api
ExecStart=/usr/bin/node /var/www/linear/api/server.js
Restart=on-failure
RestartSec=5
Environment=PORT=47291
EnvironmentFile=/etc/linear/env

[Install]
WantedBy=multi-user.target
